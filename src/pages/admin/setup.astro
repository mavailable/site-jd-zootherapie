---
// Shim de la page de setup du package : rend SetupPage en lui passant le locale
// et l'id Umami (pour tracer l'ouverture de la page d'onboarding — #130).
import SetupPage from '@marc/cms-engine/astro/setup';
import cmsConfig from '../../../cms.config';

const config = cmsConfig as { locale?: 'fr' | 'en'; site?: { umamiSiteId?: string } };
const locale = config.locale === 'en' ? 'en' : 'fr';
const umamiWebsiteId = config.site?.umamiSiteId;
---
<SetupPage locale={locale} umamiWebsiteId={umamiWebsiteId} />
