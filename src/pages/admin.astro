---
// Page d'administration CMS — ne pas indexer
import '../styles/cms.css';
import { CmsApp } from '../components/cms/CmsApp';
import cmsConfig from '../../cms.config';

const cmsLocale = (cmsConfig as { locale?: 'fr' | 'en' }).locale === 'en' ? 'en' : 'fr';
const adminTitle = cmsLocale === 'en' ? 'Admin' : 'Administration';
---

<!doctype html>
<html lang={cmsLocale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{cmsConfig.siteName} — {adminTitle}</title>
    <style>
      *,
      *::before,
      *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }
      body {
        font-family:
          -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial,
          sans-serif;
        background: #f8fafc;
        color: #1e293b;
        line-height: 1.5;
        -webkit-font-smoothing: antialiased;
      }
    </style>
  </head>
  <body>
    <script define:vars={{ cfg: cmsConfig }} is:inline>
      window.__cmsConfig = cfg;
    </script>
    <CmsApp client:only="react" />
  </body>
</html>
