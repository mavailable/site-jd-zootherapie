---
/**
 * UmamiTag.astro : mesure d'audience Umami (sans cookie), chargee APRES la premiere
 * frame reellement rendue (load, double requestAnimationFrame, puis requestIdleCallback).
 * Meme garde que GoogleTag.astro : un script tiers qui finit de charger avant le premier
 * rendu est compte dans le LCP simule de Lighthouse et de PSI (audit perf du 2026-09-11).
 * Le suivi reste complet : Umami enregistre la page vue au chargement du script, et
 * public/js/analytics.js teste window.umami au moment du clic, pas au cablage.
 * Utilise par BaseLayout et AdsLayout.
 */
const websiteId = '96fd46e0-47fa-4c79-abda-447fa79bd0f4';
---
<script is:inline define:vars={{ websiteId }}>
  (function () {
    function inject() {
      var s = document.createElement('script');
      s.async = true;
      s.src = 'https://cloud.umami.is/script.js';
      s.setAttribute('data-website-id', websiteId);
      s.crossOrigin = 'anonymous';
      document.head.appendChild(s);
    }
    function afterFirstPaint() {
      requestAnimationFrame(function () {
        requestAnimationFrame(function () {
          if ('requestIdleCallback' in window) requestIdleCallback(inject, { timeout: 2000 });
          else setTimeout(inject, 200);
        });
      });
    }
    if (document.readyState === 'complete') afterFirstPaint();
    else window.addEventListener('load', afterFirstPaint, { once: true });
  })();
</script>
