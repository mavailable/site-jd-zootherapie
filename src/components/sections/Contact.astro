---
import { getSiteInfo, getContact } from '@data/content';
import { ads } from '@data/business';

const siteInfo = await getSiteInfo();
const contact = await getContact();

// Libelles du parcours d'envoi (module « forms » du moteur). Repli code en dur
// uniquement si le champ n'existe pas encore dans le contenu.
const sending = contact.sending || 'Envoi en cours…';
const successHeading = contact.successHeading || 'Merci, votre message est bien parti.';
const successBody = contact.successBody || 'Jennifer a reçu votre demande et vous recontacte sous 48 heures.';
const errorMessage = contact.errorMessage || `L'envoi a échoué. Réessayez, ou appelez Jennifer au ${siteInfo.phoneDisplay}.`;
---

<section id="contact" class="bg-white py-16 md:py-20">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="text-center mb-10">
      <h2 class="font-heading font-semibold text-2xl md:text-[2rem] text-primary-900 mb-3" data-cms-field="contact.title" data-cms-type="text">
        {contact.title}
      </h2>
      <p class="text-neutral-600 leading-relaxed max-w-xl mx-auto text-sm" data-cms-field="contact.subtitle" data-cms-type="text">
        {contact.subtitle}
      </p>
    </div>

    <!-- 3 cartes de contact -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-5 mb-12 max-w-4xl mx-auto">

      <!-- Carte 1 : Réserver un appel (cal.eu) — mise en avant -->
      <a
        href="https://cal.eu/jdzootherapie/30min"
        target="_blank"
        rel="noopener noreferrer"
        class="group bg-accent-50 border-2 border-accent-200 rounded-xl p-6 text-center hover:border-accent-400 hover:shadow-md transition-all"
      >
        <div class="inline-flex items-center justify-center w-12 h-12 bg-accent-100 text-accent-700 rounded-xl mb-4 group-hover:bg-accent-200 transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
        </div>
        <h3 class="font-heading font-semibold text-primary-900 mb-1"
            data-cms-field="contact.bookingLabel" data-cms-type="text">{contact.bookingLabel || 'Réserver un appel'}</h3>
        <p class="text-xs text-neutral-500 mb-3">Choisissez un créneau de 30 min — Jennifer vous rappelle.</p>
        <span class="inline-flex items-center gap-1 text-accent-700 font-semibold text-sm group-hover:gap-2 transition-all">
          Prendre RDV
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
        </span>
      </a>

      <!-- Carte 2 : Appeler -->
      <a
        href={`tel:${siteInfo.phone}`}
        class="group bg-white border-2 border-primary-200 rounded-xl p-6 text-center hover:border-primary-400 hover:shadow-md transition-all"
      >
        <div class="inline-flex items-center justify-center w-12 h-12 bg-primary-100 text-primary-600 rounded-xl mb-4 group-hover:bg-primary-200 transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
        </div>
        <h3 class="font-heading font-semibold text-primary-900 mb-1"
            data-cms-field="contact.phoneLabel" data-cms-type="text">{contact.phoneLabel || 'Appeler Jennifer'}</h3>
        <p class="text-xs text-neutral-500 mb-3">Réponse immédiate aux heures ouvrables.</p>
        <span class="inline-flex items-center gap-1 text-primary-600 font-semibold text-sm">
          {siteInfo.phoneDisplay}
        </span>
      </a>

      <!-- Carte 3 : Formulaire (scroll vers le bas) -->
      <button
        type="button"
        onclick="document.getElementById('contact-form-section').scrollIntoView({behavior:'smooth'})"
        class="group bg-white border-2 border-neutral-200 rounded-xl p-6 text-center hover:border-primary-300 hover:shadow-md transition-all cursor-pointer text-left"
      >
        <div class="inline-flex items-center justify-center w-12 h-12 bg-neutral-100 text-neutral-600 rounded-xl mb-4 group-hover:bg-primary-100 group-hover:text-primary-600 transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
        </div>
        <h3 class="font-heading font-semibold text-primary-900 mb-1"
            data-cms-field="contact.emailLabel" data-cms-type="text">{contact.emailLabel || 'Envoyer un message'}</h3>
        <p class="text-xs text-neutral-500 mb-3">Pour les demandes détaillées ou les structures.</p>
        <span class="inline-flex items-center gap-1 text-primary-600 font-semibold text-sm group-hover:gap-2 transition-all">
          Écrire
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
        </span>
      </button>
    </div>

    <!-- Infos complémentaires -->
    <div class="flex flex-wrap justify-center gap-6 mb-12 text-sm text-neutral-600">
      <div class="flex items-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-primary-500 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
        <span>{siteInfo.address.postalCode} {siteInfo.address.city} — Metz, Thionville et toute la Moselle</span>
      </div>
      <a href={`mailto:${siteInfo.email}`} class="flex items-center gap-2 hover:text-primary-600 transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-primary-500 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
        <span>{siteInfo.email}</span>
      </a>
      <a
        href="/plaquette-jd-zootherapie.pdf"
        download="Plaquette-JD-Zootherapie.pdf"
        class="flex items-center gap-2 hover:text-primary-600 transition-colors"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-primary-500 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
        <span>Plaquette PDF</span>
      </a>
    </div>

    <!-- Formulaire -->
    <div id="contact-form-section" class="max-w-2xl mx-auto">
      <div class="bg-neutral-50 border border-neutral-200 rounded-xl p-6 md:p-8">
        <div id="contact-form-wrap">
        <h3 class="font-heading font-semibold text-lg text-primary-900 mb-5">Envoyer un message</h3>

          <div aria-live="polite" aria-atomic="true" class="sr-only" id="form-status"></div>
          {/* Formulaire maison : envoi meme origine vers /api/form-submit. action +
              method servent de repli sans JavaScript (le module redirige alors vers
              la valeur du champ redirect). */}
          <form id="contact-form" action="/api/form-submit" method="POST" class="space-y-5">
            <input type="hidden" name="form_id" value="contact" />
            <input type="hidden" name="redirect" value="/merci/" />
            {/* Honeypot anti-spam : rempli = leurre, la demande n'est pas transmise. */}
            <input type="checkbox" name="botcheck" class="hidden" style="display:none" tabindex="-1" autocomplete="off" aria-hidden="true" />

            <div>
              <label for="contact-name" class="block text-sm font-medium text-neutral-800 mb-1.5">
                Votre prénom et nom <span class="text-accent-700" aria-hidden="true">*</span>
              </label>
              <input
                type="text"
                id="contact-name"
                name="name"
                required
                autocomplete="name"
                class="w-full px-4 py-3 border border-neutral-300 rounded bg-white text-neutral-800 placeholder-neutral-400 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent text-sm min-h-[44px] transition-shadow"
                placeholder="Marie Dupont"
              />
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              <div>
                <label for="contact-phone" class="block text-sm font-medium text-neutral-800 mb-1.5">Téléphone</label>
                <input
                  type="tel"
                  id="contact-phone"
                  name="phone"
                  autocomplete="tel"
                  class="w-full px-4 py-3 border border-neutral-300 rounded bg-white text-neutral-800 placeholder-neutral-400 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent text-sm min-h-[44px] transition-shadow"
                  placeholder="06 00 00 00 00"
                />
              </div>
              <div>
                <label for="contact-email" class="block text-sm font-medium text-neutral-800 mb-1.5">Email</label>
                <input
                  type="email"
                  id="contact-email"
                  name="email"
                  autocomplete="email"
                  class="w-full px-4 py-3 border border-neutral-300 rounded bg-white text-neutral-800 placeholder-neutral-400 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent text-sm min-h-[44px] transition-shadow"
                  placeholder="votre@email.fr"
                />
              </div>
            </div>

            <div>
              <label for="contact-message" class="block text-sm font-medium text-neutral-800 mb-1.5">
                Votre message <span class="text-accent-700" aria-hidden="true">*</span>
              </label>
              <textarea
                id="contact-message"
                name="message"
                required
                rows="4"
                class="w-full px-4 py-3 border border-neutral-300 rounded bg-white text-neutral-800 placeholder-neutral-400 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent text-sm resize-y transition-shadow"
                placeholder="Décrivez votre situation en quelques mots..."
              ></textarea>
            </div>

            <div class="flex items-start gap-2">
              <input type="checkbox" id="contact-consent" name="Consentement RGPD" value="oui" required
                class="mt-1 w-4 h-4 rounded border-neutral-300 text-primary-600 focus:ring-primary-500" />
              <label for="contact-consent" class="text-neutral-500 text-xs leading-relaxed">
                J'accepte que mes données soient utilisées pour répondre à ma demande.
                <a href="/politique-confidentialite/" class="underline hover:text-primary-600 transition-colors">Politique de confidentialité</a>.
              </label>
            </div>

            {ads.enabled && (
              <div class="flex items-start gap-2">
                <input type="checkbox" id="contact-ads-consent" name="Consentement mesure publicitaire" value="oui"
                  class="mt-1 w-4 h-4 rounded border-neutral-300 text-primary-600 focus:ring-primary-500" />
                <label for="contact-ads-consent" class="text-neutral-500 text-xs leading-relaxed">
                  J'accepte de transmettre de manière hachée (anonyme) mon email et mon téléphone à Google Ads pour améliorer la mesure des conversions publicitaires. Facultatif.
                </label>
              </div>
            )}

            <p
              id="contact-error"
              role="alert"
              aria-live="assertive"
              class="hidden rounded border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700"
            ></p>

            <div class="flex flex-col sm:flex-row sm:items-center gap-4">
              <button
                type="submit"
                id="contact-submit"
                class="inline-flex items-center justify-center gap-2 bg-accent-700 text-white px-7 py-3.5 rounded font-semibold text-base hover:bg-accent-800 transition-colors min-h-[44px] w-full sm:w-auto disabled:opacity-70 disabled:cursor-not-allowed"
              >
                <span class="contact-submit-label" data-cms-field="contact.buttonText" data-cms-type="text">{contact.buttonText}</span>
                <span class="contact-submit-sending hidden items-center gap-2">
                  <svg class="w-5 h-5 animate-spin" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"></path>
                  </svg>
                  <span data-cms-field="contact.sending" data-cms-type="text">{sending}</span>
                </span>
              </button>
            </div>
          </form>
        </div>

        {/* Confirmation d'envoi, revelee a la place du formulaire apres l'envoi.
            Editable dans /admin, rubrique Contact. */}
        <div id="contact-success" class="hidden focus:outline-none" role="status" aria-live="polite" tabindex="-1">
          <div class="text-center py-4">
            <div class="inline-flex items-center justify-center w-16 h-16 bg-accent-700 text-white rounded-full mb-5">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>
            </div>
            <h3 class="font-heading font-semibold text-xl text-primary-900 mb-3" data-cms-field="contact.successHeading" data-cms-type="text">{successHeading}</h3>
            <p class="text-neutral-600 leading-relaxed max-w-md mx-auto" data-cms-field="contact.successBody" data-cms-type="text">{successBody}</p>
            <div class="mt-7 flex flex-col sm:flex-row gap-3 justify-center">
              <a href={`tel:${siteInfo.phone}`} class="inline-flex items-center justify-center gap-2 bg-accent-700 text-white px-6 py-3 rounded font-semibold text-sm hover:bg-accent-800 transition-colors min-h-[44px]">
                Appeler Jennifer
              </a>
              <a href="/" class="inline-flex items-center justify-center gap-2 border-2 border-primary-200 text-primary-700 px-6 py-3 rounded font-semibold text-sm hover:border-primary-400 transition-colors min-h-[44px]">
                Retour à l'accueil
              </a>
            </div>
          </div>
        </div>

        <script is:inline define:vars={{ errNetwork: errorMessage }}>
          (function () {
            function setup() {
              var form = document.getElementById('contact-form');
              if (!form || form.dataset.bound === '1') return;
              form.dataset.bound = '1';
              var shownAt = Date.now();

              var wrap = document.getElementById('contact-form-wrap');
              var succes = document.getElementById('contact-success');
              var erreur = document.getElementById('contact-error');
              var btn = document.getElementById('contact-submit');
              var label = btn.querySelector('.contact-submit-label');
              var sending = btn.querySelector('.contact-submit-sending');

              function enEnvoi(on) {
                btn.disabled = on;
                label.classList.toggle('hidden', on);
                sending.classList.toggle('hidden', !on);
                sending.classList.toggle('inline-flex', on);
              }

              function reussi() {
                var reduit = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
                wrap.classList.add('hidden');
                succes.classList.remove('hidden');
                succes.style.opacity = '0';
                succes.style.transform = reduit ? 'none' : 'translateY(12px)';
                succes.style.transition = reduit ? 'none' : 'opacity 420ms ease, transform 420ms ease';
                requestAnimationFrame(function () {
                  requestAnimationFrame(function () {
                    succes.style.opacity = '1';
                    succes.style.transform = 'none';
                  });
                });
                succes.focus({ preventScroll: true });
                succes.scrollIntoView({ behavior: reduit ? 'auto' : 'smooth', block: 'center' });
              }

              form.addEventListener('submit', function (ev) {
                ev.preventDefault();
                if (!form.reportValidity()) return;
                erreur.classList.add('hidden');
                enEnvoi(true);

                var envoi = new FormData(form);
                envoi.append('_dt', String(Date.now() - shownAt));

                fetch(form.action, {
                  method: 'POST',
                  headers: { Accept: 'application/json' },
                  body: envoi,
                })
                  .then(function (r) { return r.json(); })
                  .then(function (d) {
                    if (d && d.success) reussi();
                    else throw new Error('envoi');
                  })
                  .catch(function () {
                    erreur.textContent = errNetwork;
                    erreur.classList.remove('hidden');
                    enEnvoi(false);
                    erreur.scrollIntoView({ behavior: 'smooth', block: 'center' });
                  });
              });
            }
            if (document.readyState !== 'loading') setup();
            else document.addEventListener('DOMContentLoaded', setup);
            document.addEventListener('astro:after-swap', setup);
          })();
        </script>

          {ads.enabled && (
            <script is:inline>
              {`
              (function() {
                async function sha256(value) {
                  if (!value) return '';
                  var normalized = String(value).trim().toLowerCase().replace(/\\s+/g, '');
                  var buf = new TextEncoder().encode(normalized);
                  var hash = await crypto.subtle.digest('SHA-256', buf);
                  return Array.from(new Uint8Array(hash))
                    .map(function(b) { return b.toString(16).padStart(2, '0'); }).join('');
                }

                var form = document.getElementById('contact-form');
                if (!form) return;

                form.addEventListener('submit', async function(e) {
                  var adsConsent = document.getElementById('contact-ads-consent');
                  if (!adsConsent || !adsConsent.checked) return;
                  if (typeof window.gtag !== 'function') return;

                  var emailEl = document.getElementById('contact-email');
                  var phoneEl = document.getElementById('contact-phone') || document.getElementById('contact-tel');
                  var email = emailEl && emailEl.value ? emailEl.value : '';
                  var phone = phoneEl && phoneEl.value ? phoneEl.value : '';

                  var hashedEmail = email ? await sha256(email) : '';
                  var hashedPhone = phone ? await sha256(phone.replace(/[^0-9+]/g, '')) : '';

                  window.gtag('event', 'conversion', {
                    send_to: '${ads.conversionId}',
                    event_category: 'lead',
                    event_label: 'contact_form',
                    user_data: {
                      sha256_email_address: hashedEmail,
                      sha256_phone_number: hashedPhone,
                    },
                  });
                });
              })();
              `}
            </script>
          )}
        </div>
      </div>
    </div>
  </div>
</section>
