# En-tetes de securite, jeu standard du parc (reference paccord-piano, generate-headers.js).
# Sans preload HSTS. includeSubDomains : aucun sous-domaine de la zone n'est servi en HTTP seul.
# X-Frame-Options DENY : le moteur ne cadre aucune page du site (edition inline en premier plan).
# Pas de Content-Security-Policy ici : elle demande un travail dedie (gtag, Google Ads, Umami).
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  Permissions-Policy: camera=(), microphone=(self), geolocation=(), payment=()
  X-XSS-Protection: 0

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/favicon.svg
  Cache-Control: public, max-age=86400
